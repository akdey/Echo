# Database Connections (Neon PostgreSQL / Generic PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require


# Redis Configurations
REDIS_HOST=localhost
REDIS_PORT=6379


# Alerting Credentials (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# Scoring and Screener Limits
CONVICTION_ALERT_THRESHOLD=75
SCREENER_TICKER_LIMIT=20

# Persistent Storage Path (optional - defaults to backend/data_store)
PERSISTENT_STORAGE_DIR=

# Angel One SmartAPI Credentials
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
ECHO_TOTAL_CAPITAL=1000000.0
