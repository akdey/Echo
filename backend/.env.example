# Database Connections (Neon PostgreSQL / Supabase Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Supabase Configurations (Legacy REST fallback)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Redis Configurations
REDIS_HOST=localhost
REDIS_PORT=6379

# Local LLM / Ollama (optional)
OLLAMA_URL=http://localhost:11434

# Alerting Credentials (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# Scoring and Screener Limits
CONVICTION_ALERT_THRESHOLD=75
SCREENER_TICKER_LIMIT=20

# Persistent Storage Path (optional - defaults to backend/data_store)
PERSISTENT_STORAGE_DIR=
